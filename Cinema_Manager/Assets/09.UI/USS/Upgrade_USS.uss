.base-container {
    position: absolute;
    height: 40%;
    width: 100%;
    bottom: 0;
    background-color: rgba(255, 192, 84, 0.53);
}

.title-content {
    width: 600px;
    flex-grow: 1;
    background-color: rgb(255, 241, 173);
    bottom: 75px;
}

.upgrade-icon {
    width: 320px;
    height: 320px;
}

.upgrade-content {
    align-items: center;
    justify-content: center;
    height: 80%;
}

.upgrade-panel {
    background-color: rgb(114, 210, 245);
    flex-grow: 1;
}

.upgradebar-content {
    width: 350px;
    height: 30px;
    flex-direction: row;
    justify-content: space-between;
    bottom: -25px;
}

.upgrade-gauge {
    width: 18%;
    height: 100%;
    background-image: url("project://database/Assets/04.Sprites/UI/WhiteRoundSquare.png?fileID=21300000&guid=4e1c0ea700845c54c8cede4760dfe8ac&type=3#WhiteRoundSquare");
}

.upgrade-gauge.off {
    width: 18%;
    height: 100%;
    background-image: url("project://database/Assets/04.Sprites/UI/WhiteRoundSquare.png?fileID=21300000&guid=4e1c0ea700845c54c8cede4760dfe8ac&type=3#WhiteRoundSquare");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.49);
}

.main-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.button-container {
    align-items: center;
    justify-content: center;
    height: 30%;
}

.close-view-btn {
    position: absolute;
    height: 170px;
    width: 170px;
    top: -57%;
    left: 80%;
    background-image: url("project://database/Assets/04.Sprites/UI/RedX.png?fileID=21300000&guid=a243b1f436d60f945952044361efc91d&type=3#RedX");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}
