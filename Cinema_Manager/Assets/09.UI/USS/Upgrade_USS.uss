.base-container {
    position: absolute;
    height: 950px;
    width: 100%;
    bottom: 0;
    background-color: rgba(255, 192, 84, 0.53);
}

.title-content {
    width: 600px;
    flex-grow: 1;
    background-color: rgb(255, 241, 173);
    bottom: 75px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.upgrade-icon {
    width: 300px;
    height: 300px;
}

.upgrade-content {
    align-items: center;
    justify-content: center;
    height: 85%;
}

.upgrade-panel {
    background-color: rgb(114, 210, 245);
    flex-grow: 1;
    justify-content: space-around;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-right-radius: 13px;
    border-bottom-left-radius: 13px;
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
}

.main-container {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-basis: 350px;
}

.button-container {
    align-items: center;
    justify-content: center;
    height: 30%;
}

.upgrade-panel-top-container {
    width: 100%;
    height: 80px;
}

.upgradebar-content {
    width: 350px;
    height: 30px;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.upgrade-gauge {
    width: 18%;
    height: 100%;
    background-image: url("project://database/Assets/04.Sprites/UI/WhiteRoundSquare.png?fileID=21300000&guid=4e1c0ea700845c54c8cede4760dfe8ac&type=3#WhiteRoundSquare");
}

.upgrade-gauge.off {
    width: 18%;
    height: 100%;
    background-image: url("project://database/Assets/04.Sprites/UI/WhiteRoundSquare.png?fileID=21300000&guid=4e1c0ea700845c54c8cede4760dfe8ac&type=3#WhiteRoundSquare");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.49);
}

.close-view-btn {
    position: absolute;
    height: 170px;
    width: 170px;
    top: -57%;
    left: 80%;
    background-image: url("project://database/Assets/04.Sprites/UI/RedX.png?fileID=21300000&guid=a243b1f436d60f945952044361efc91d&type=3#RedX");
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}
