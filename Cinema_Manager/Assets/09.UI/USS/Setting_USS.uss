.top_bottom-container {
    height: 12%;
    max-height: 15%;
    min-height: 150px;
    width: 100%;
    margin-bottom: 20px;
    margin-top: 20px;
    align-items: center;
    justify-content: center;
}

.main-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    width: 100%;
}

.sound-content {
    margin-top: 20px;
    margin-bottom: 20px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-right: 40px;
    margin-left: 40px;
}

.button-content {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
}

.unity-base-field > VisualElement > #unity-checkmark {
    width: 100%;
    height: 100%;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(49, 49, 49);
    border-right-color: rgb(49, 49, 49);
    border-top-color: rgb(49, 49, 49);
    border-bottom-color: rgb(49, 49, 49);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.slider {
    width: 65%;
    height: 70px;
}

.settingView-icon {
    width: 200px;
    height: 200px;
}

.toggle {
    width: 100px;
    height: 100px;
}

.background {
    border-top-left-radius: 35px;
    border-top-right-radius: 35px;
    border-bottom-right-radius: 35px;
    border-bottom-left-radius: 35px;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(255, 255, 255);
    width: 60%;
    height: 40%;
    min-height: 900px;
    scale: 0.8 0.8;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out-back;
}
