                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="main-container" style="flex-grow: 1; align-items: center; justify-content: center;">
                        <ui:VisualElement name="image" class="upgrade-icon" />
                        <ui:VisualElement name="upgrade-content" style="width: 350px; height: 30px; background-color: rgb(247, 255, 92); flex-direction: row; justify-content: space-between;">
                            <ui:VisualElement name="gauge" class="upgrade-gauge off" />
                            <ui:VisualElement name="gauge" class="upgrade-gauge off" />
                            <ui:VisualElement name="gauge" class="upgrade-gauge off" />
                            <ui:VisualElement name="gauge" class="upgrade-gauge off" />
                            <ui:VisualElement name="gauge" class="upgrade-gauge off" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="button-container" style="align-items: center; justify-content: center; height: 35%;">
