    <Style src="project://database/Assets/09.UI/USS/Upgrade_USS.uss?fileID=7433441132597879392&amp;guid=bfa203c725e68ca48873f5461d8f68dd&amp;type=3#Upgrade_USS" />
    <ui:VisualElement name="container" style="position: absolute; height: 40%; width: 100%; bottom: 0; background-color: rgb(255, 255, 255);">
        <ui:VisualElement name="top-container" style="width: 100%; height: 150px; align-items: center;">
            <ui:VisualElement name="title-content" style="width: 600px; flex-grow: 1; background-color: rgb(255, 241, 173); bottom: 75px;">
                <ui:Label tabindex="-1" text="직원" parse-escape-sequences="true" display-tooltip-when-elided="true" name="title" class="text_middle-array_100" />
            </ui:VisualElement>
            <ui:Button text="닫기" parse-escape-sequences="true" display-tooltip-when-elided="true" name="close-btn" class="text_middle-array_50" style="position: absolute; height: 122px; width: 200px; top: -40%; left: 79%;" />
        </ui:VisualElement>
        <ui:VisualElement name="main-container" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-around;">
            <ui:VisualElement name="upgrade-movespeed-content" style="align-items: center; justify-content: center; height: 100%;">
                <ui:VisualElement name="updrade-panel" style="width: 400px; height: 80%; background-color: rgb(198, 255, 178); margin-bottom: 40px;">
                    <ui:VisualElement name="top-container" style="width: 100%; height: 80px;">
                        <ui:VisualElement name="title-content" style="flex-grow: 1;">
